# Docker Compose project identity and exposed entry point.
COMPOSE_PROJECT_NAME=scholar
BIND_HOST=0.0.0.0
LOCAL_BIND_HOST=127.0.0.1
WEB_PORT=3000
KOTAEMON_PORT=7860
CITATION_GRAPH_PORT=8001
VIBEVOICE_PORT=8002

# Image names can be replaced by registry images in CI or deployment.
WEB_IMAGE=scholar-web:local
KOTAEMON_IMAGE=scholar-kotaemon:local
CITATION_GRAPH_IMAGE=scholar-citation-graph:local
VIBEVOICE_IMAGE=scholar-vibevoice:local

# A named volume or an explicit bind path are both accepted.
# Example bind paths: ./data, D:/Scholar/data, /srv/scholar/data
SCHOLAR_DATA_VOLUME=scholar-data
SCHOLAR_DATA_VOLUME_NAME=scholar-data
KOTAEMON_DATA_VOLUME=kotaemon-data
KOTAEMON_DATA_VOLUME_NAME=kotaemon-data
CITATION_CACHE_VOLUME=citation-cache
CITATION_CACHE_VOLUME_NAME=citation-cache
CITATION_EXPORT_VOLUME=citation-exports
CITATION_EXPORT_VOLUME_NAME=citation-exports
VIBEVOICE_MODEL_VOLUME=vibevoice-models
VIBEVOICE_MODEL_VOLUME_NAME=vibevoice-models
VIBEVOICE_OUTPUT_VOLUME=vibevoice-outputs
VIBEVOICE_OUTPUT_VOLUME_NAME=vibevoice-outputs

# Linux bind mounts use these ownership values.
SCHOLAR_UID=1000
SCHOLAR_GID=1000

# Runtime secrets. Replace every value before the first start.
AUTH_SECRET=replace-with-a-random-48-byte-secret
CHAT_BFF_TOKEN=replace-with-a-random-internal-token
KOTAEMON_ADMIN_USERNAME=admin
KOTAEMON_ADMIN_PASSWORD=replace-with-a-strong-admin-password
EVALUATION_RESULTS_PATH=/app/evaluation/results.json

# Bailian/OpenAI-compatible model provider.
OPENAI_API_BASE=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=replace-with-your-bailian-key
OPENAI_CHAT_MODEL=qwen3.8-flash
OPENAI_COMPLEX_MODEL=qwen3.8-max
OPENAI_EMBEDDINGS_MODEL=qwen3.7-text-embedding
OPENAI_RERANK_MODEL=qwen3-rerank
OPENAI_OCR_MODEL=qwen3.5-ocr
OPENAI_CHAT_MAX_TOKENS=1000
AGENT_PLANNER_MODEL=qwen3.8-flash
AGENT_PLANNER_MAX_STEPS=4
AGENT_PLANNER_TIMEOUT=90
GRAPHRAG_ENABLED=true
GRAPHRAG_TOP_K=8
GRAPHRAG_MAX_HOPS=2
KH_RETRIEVAL_MODE=hybrid

# Citation metadata providers.
OPENALEX_BASE_URL=https://api.openalex.org
CROSSREF_BASE_URL=https://api.crossref.org
OPENALEX_MAILTO=
CROSSREF_MAILTO=
CITATION_CACHE_TTL=86400
CITATION_HTTP_TIMEOUT=30

# Optional VibeVoice profile. Use: docker compose --profile voice up
COMPOSE_PROFILES=
VIBEVOICE_URL=http://vibevoice:8002
VIBEVOICE_BASE_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
VIBEVOICE_REPOSITORY=https://github.com/microsoft/VibeVoice.git
VIBEVOICE_REF=main
VIBEVOICE_MODEL_PATH=microsoft/VibeVoice-Realtime-0.5B
VIBEVOICE_DEVICE=cuda
VIBEVOICE_WARMUP=1
